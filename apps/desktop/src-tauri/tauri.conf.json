{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Engram",
  "version": "0.1.0",
  "identifier": "dev.engram.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @engram/ui",
    "beforeBuildCommand": "npm run build -w @engram/ui"
  },
  "app": {
    "windows": [
      {
        "title": "Engram",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0b0e14"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
